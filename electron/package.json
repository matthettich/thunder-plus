{
  "name": "thunder-plus",
  "productName": "Thunder Plus",
  "version": "1.1.0",
  "description": "...Thunder Plus: drum synth, bass synth and tracker.",
  "author": "Matt Hettich",
  "license": "UNLICENSED",
  "main": "main.js",
  "private": true,
  "scripts": {
    "copy": "node copy-app.js",
    "start": "npm run copy && electron .",
    "dist": "npm run copy && electron-builder --publish never",
    "dist:win": "npm run copy && electron-builder --win --publish never",
    "dist:mac": "npm run copy && electron-builder --mac --publish never",
    "dist:linux": "npm run copy && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.matthettich.thunderplus",
    "productName": "Thunder Plus",
    "artifactName": "Thunder-Plus-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "updater.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/icons/plus-icon-512.png"
    },
    "portable": {
      "artifactName": "Thunder-Plus-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "...Thunder Plus"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "app/icons/plus-icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "icon": "app/icons/plus-icon-512.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "matthettich",
        "repo": "thunder-plus",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}
