# The build step that makes the app's files: cmake -DREPO=<repo root> -DDEST=<dir> -P copy_web.cmake
# The same list as electron/copy-app.js (PARTS): what index.html loads at run time, from the repo root. lxr/ (the optional drum firmware voices, GPL-3.0) only when it is in the checkout.
# The run-time check is copy-app.js's too: every file index.html names must be there (a missing one stops the build).
if(NOT REPO OR NOT DEST)
  message(FATAL_ERROR "copy_web.cmake: -DREPO and -DDEST are required")
endif()
file(REMOVE_RECURSE "${DEST}")
file(MAKE_DIRECTORY "${DEST}")
set(PARTS index.html manifest.webmanifest master-worklet.js core icons fonts waves chains pump sounds wavetables THIRD_PARTY_NOTICES.md)
if(EXISTS "${REPO}/lxr")
  list(APPEND PARTS lxr)
endif()
foreach(p IN LISTS PARTS)
  if(NOT EXISTS "${REPO}/${p}")
    message(FATAL_ERROR "Missing from the app: ${p}")
  endif()
  if(IS_DIRECTORY "${REPO}/${p}")
    file(COPY "${REPO}/${p}" DESTINATION "${DEST}")
  else()
    file(COPY "${REPO}/${p}" DESTINATION "${DEST}")
  endif()
endforeach()
file(STRINGS "${DEST}/index.html" refs REGEX "(waves|chains|pump|core|fonts|icons)/[A-Za-z0-9_./-]+|master-worklet\\.js")
set(missing "")
foreach(line IN LISTS refs)
  string(REGEX MATCHALL "[\"'`(]((waves|chains|pump|core|fonts|icons)/[A-Za-z0-9_./-]+|master-worklet\\.js)" hits "${line}")
  foreach(h IN LISTS hits)
    string(SUBSTRING "${h}" 1 -1 f)
    if(NOT EXISTS "${DEST}/${f}")
      list(APPEND missing "${f}")
    endif()
  endforeach()
endforeach()
if(missing)
  list(REMOVE_DUPLICATES missing)
  message(FATAL_ERROR "index.html loads files that are not in the app: ${missing}")
endif()
message(STATUS "web bundle: ${DEST}")
