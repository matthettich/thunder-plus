<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- H8: the hardened-runtime entitlements (mac/sign.sh passes this file to codesign). Under the hardened runtime macOS refuses an audio input (the interface's inputs, a microphone) unless the app carries
     com.apple.security.device.audio-input (with NSMicrophoneUsageDescription in Info.plist, H7). Nothing else is asked for: the app is not sandboxed, loads no third-party libraries, makes no JIT code
     in its own process (the web content runs in WebKit's own processes) and needs no network entitlement outside a sandbox. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
